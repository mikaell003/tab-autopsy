{
  "manifest_version": 3,
  "name": "Tab Autopsy",
  "version": "1.0.0",
  "description": "Idle tabs get buried, not lost. Search the graveyard by what you actually meant, and bring any of them back.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Autopsy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
